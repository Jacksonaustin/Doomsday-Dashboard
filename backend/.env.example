
# MongoDB connection
MONGO_URI=your-mongodb-atlas-connection-string

# Random secret, at least 32 characters
JWT_SECRET=replace-with-your-own-long-random-secret

# Backend port
PORT=5050

# AI service (ml-recommend). Docker Compose sets this for you.
# Without it, recommendations fall back to generic advice.
AI_SERVICE_URL=http://127.0.0.1:8000
